# Copy this file to .env. Never commit .env.
# Use only the anon/publishable key here. The service role key must never go in the app.

# Local database: run `npx supabase status` and copy the API URL and the anon/publishable key.
# Keep 127.0.0.1 here. In development the app swaps it for your PC's address on a phone.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-local-key-here

# Production (Phase 6):
# EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
